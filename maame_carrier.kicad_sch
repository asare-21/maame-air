	(text "   J3 takes a thin VBAT tap (20 AWG) from the ESC pads for the micro BEC only, through F1."
		(exclude_from_sim no)
		(at 20.32 254 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "068ff682-2c6d-51ef-8543-f47496a08285")
	)
	(text "MAAME CARRIER BOARD  rev A (draft, layout pending frame measurements)"
		(exclude_from_sim no)
		(at 20.32 243.84 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1d59c417-e219-5524-a0ad-c01a7caa4b85")
	)
	(text "5. UART nets are named from the FC side: UARTn_FC_TX goes to the device RX."
		(exclude_from_sim no)
		(at 20.32 279.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "20f7ae6a-8348-501a-a4c5-31b85c97604e")
	)
	(text "6. Pi I2C/GPIO on J7 are 3.3 V. Do not connect them to the FC I2C bus (5 V pull-ups on GPS)."
		(exclude_from_sim no)
		(at 20.32 284.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "2cafb923-0065-5192-872f-071b38677c1a")
	)
	(text "3. Every Kakute link is a soldered wire into J1/J2 (labelled), never a plug-to-plug cable, so a reversed"
		(exclude_from_sim no)
		(at 20.32 264.16 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "35b10f71-6a7b-5cc5-b710-5cbc5bef5ad1")
	)
	(text "1. The 65 A battery path is NOT on this board: XT60 -> Tekko32 BAT+/BAT- with 12 AWG, 1000uF 35V at the ESC pads."
		(exclude_from_sim no)
		(at 20.32 248.92 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "3f698ecd-447b-56a2-a2b4-9626e8c3edcc")
	)
	(text "4. 5V_AUX (micro BEC: Pi, servos) and 5V_FC (Kakute 5 V: GPS, SiK, RX, TF-Luna) are separate rails. GND shared."
		(exclude_from_sim no)
		(at 20.32 274.32 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "ac000c21-9042-5125-8c9e-0a4774eda63b")
	)
	(text "7. UNCONFIRMED: TF-Luna lead order, SiK lead order, M10Q lead colours. Silkscreen labels every pin; beep before soldering."
		(exclude_from_sim no)
		(at 20.32 289.56 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "b637b9a9-986b-5b28-8979-43cd75cbc46a")
	)
	(text "2. Kakute H7 + Tekko32 stack on H1-H4 (30.5 mm, M3), stock 8-pin ESC cable between them, unchanged."
		(exclude_from_sim no)
		(at 20.32 259.08 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "c01610f1-1acd-5b41-b447-0fbae8c3cbfa")
	)
	(text "   JST lead can't put 9 V or B+ onto a signal. 9V, B+ and R7 are deliberately not brought down."
		(exclude_from_sim no)
		(at 20.32 269.24 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "f56836a7-e386-534d-bb0e-c2f885cdcbab")
	)
